@model Poslasticarnica.Modeli.Narudzbina

@{
    ViewData["Title"] = "Brisanje narudžbine";
}

<div class="container mt-4">

    <h2>Brisanje narudžbine</h2>

    <hr />

    <div class="alert alert-warning">
        Da li ste sigurni da želite da obrišete ovu narudžbinu?
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <p>
                <strong>ID:</strong>
                @Model.NarudzbinaID
            </p>

            <p>
                <strong>Kupac:</strong>
                @Model.ImePrezimeKupca
            </p>

            <p>
                <strong>Datum preuzimanja:</strong>
                @Model.DatumPreuzimanja.ToString("dd.MM.yyyy. HH:mm")
            </p>

            <p>
                <strong>Status:</strong>
                @Model.Status
            </p>

            <p>
                <strong>Cena:</strong>
                @Model.UkupnaCena.ToString("N2") din
            </p>

        </div>
    </div>

    <form asp-controller="Narudzbina"
          asp-action="Obrisi"
          method="post"
          class="mt-3">

        <input type="hidden"
               name="id"
               value="@Model.NarudzbinaID" />

        <button type="submit"
                class="btn btn-danger">
            Obriši
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Odustani
        </a>

    </form>

</div>