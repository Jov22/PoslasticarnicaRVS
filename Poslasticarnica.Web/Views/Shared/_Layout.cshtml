<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Slatki Kutak</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Poslasticarnica.Web.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-light slatki-navbar">

            <div class="container">

                <a class="navbar-brand slatki-logo"
                   asp-controller="Pocetna"
                   asp-action="Index">

                    🍰 Slatki Kutak

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse
                        d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Pocetna"
                               asp-action="Index">

                                Početna

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Narudzbina"
                               asp-action="Index">

                                Narudžbine

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="TipTorte"
                               asp-action="Index">

                                Tipovi torti

                            </a>

                        </li>

                    </ul>

                    <ul class="navbar-nav align-items-center">

                        @if (Context.Session.GetString("KorisnickoIme") != null)
                        {
                            <li class="nav-item">

                                <span class="nav-link korisnik-ime">

                                    👤 @Context.Session.GetString("KorisnickoIme")

                                </span>

                            </li>

                            <li class="nav-item">

                                <a class="btn btn-odjava"
                                   asp-controller="Korisnik"
                                   asp-action="Odjava">

                                    Odjava

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <main role="main">

        @RenderBody()

    </main>


    <footer class="slatki-footer">

        <div class="container text-center">

            <span>
                © 2026 Slatki Kutak
            </span>

            <span class="mx-2">•</span>

            <span>
                Sistem za upravljanje narudžbinama
            </span>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>