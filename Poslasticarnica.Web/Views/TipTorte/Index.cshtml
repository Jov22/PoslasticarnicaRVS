@model List<Poslasticarnica.Modeli.TipTorte>

@{
    ViewData["Title"] = "Tipovi torti";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Tipovi torti</h2>

        <a asp-action="Dodaj"
           class="btn btn-primary">
            Novi tip torte
        </a>
    </div>

    @if (ViewBag.Greska != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Greska
        </div>
    }

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Naziv</th>
                <th>Akcije</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var tip in Model)
            {
                <tr>
                    <td>@tip.TipTorteID</td>
                    <td>@tip.Naziv</td>

                    <td>
                        <a asp-action="Izmeni"
                           asp-route-id="@tip.TipTorteID"
                           class="btn btn-sm btn-warning">
                            Izmeni
                        </a>

                        <a asp-action="Obrisi"
                           asp-route-id="@tip.TipTorteID"
                           class="btn btn-sm btn-danger">
                            Obriši
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>