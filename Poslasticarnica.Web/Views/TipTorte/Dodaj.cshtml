@model Poslasticarnica.Modeli.TipTorte

@{
    ViewData["Title"] = "Novi tip torte";
}

<div class="container mt-4">

    <h2>Novi tip torte</h2>

    <hr />

    @if (ViewBag.Greska != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Greska
        </div>
    }

    <form asp-action="Dodaj"
          method="post">

        <div class="mb-3">

            <label class="form-label">
                Naziv
            </label>

            <input asp-for="Naziv"
                   class="form-control" />

        </div>

        <button type="submit"
                class="btn btn-primary">
            Sačuvaj
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Odustani
        </a>

    </form>

</div>