@model Poslasticarnica.Web.Models.NarudzbinaViewModel

@{
    ViewData["Title"] = "Nova narudžbina";
}

<div class="container mt-4">

    <h2>Nova narudžbina</h2>

    <hr />

    @if (ViewBag.Greska != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Greska
        </div>
    }

    <form asp-controller="Narudzbina"
          asp-action="Dodaj"
          method="post">

        <div class="mb-3">
            <label class="form-label">
                Ime i prezime kupca
            </label>

            <input asp-for="Narudzbina.ImePrezimeKupca"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                Broj telefona
            </label>

            <input asp-for="Narudzbina.BrojTelefona"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                Email
            </label>

            <input asp-for="Narudzbina.Email"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                Datum preuzimanja
            </label>

            <input asp-for="Narudzbina.DatumPreuzimanja"
                   type="datetime-local"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                Tip torte
            </label>

            <select asp-for="Narudzbina.TipTorteID"
                    class="form-select">

                <option value="">-- Izaberi tip torte --</option>

                @foreach (var tip in Model.TipoviTorte)
                {
                    <option value="@tip.TipTorteID">
                        @tip.Naziv
                    </option>
                }

            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">
                Cena
            </label>

            <input asp-for="Narudzbina.UkupnaCena"
                   type="number"
                   step="0.01"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                Napomena
            </label>

            <textarea asp-for="Narudzbina.Napomena"
                      class="form-control"
                      rows="3">
            </textarea>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Sačuvaj
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Odustani
        </a>

    </form>

</div>